@echo off
REM ===========================================================================
REM  LOCAL TEST BOX - machine-local launcher settings
REM ===========================================================================
REM  Copy this file to  local.env.bat  (same folder). That name is GITIGNORED.
REM  start_local_server.bat calls it if it exists, so everything machine-local
REM  or secret lives here and never in a tracked file.
REM
REM  Every setting is OPTIONAL. With no local.env.bat at all the launcher runs
REM  unlisted on port 28960 against the default install path, which is what a
REM  test box usually wants.
REM ===========================================================================

REM --- Plutonium server key ---
REM  Leave EMPTY unless you specifically need this box listed in the in-game
REM  server browser. Two reasons the default is empty:
REM    1. The key's LABEL is the browser name, so a second server on the live
REM       key renames or shadows the real one for every player.
REM    2. A listed dev box is joinable by strangers while the RCON bridge and
REM       the dev-only verbs are live on it.
REM  Unlisted still works fine - direct connect to 127.0.0.1 or the LAN IP.
REM  Keys are issued at https://platform.plutonium.pw/serverkeys
set KEY=

REM --- Game install ------------------------------------------------------------
REM  Only needed if Black Ops is not at the path the launcher defaults to.
REM set GAMEPATH=S:\SteamLibrary\steamapps\common\Call of Duty Black Ops

REM --- Client slots ------------------------------------------------------------
REM  Mirrors the VPS bat, where sv_maxclients is supplied by the launcher and
REM  NOT by dedicated.cfg. 14 = 6v6 playing, 1 democlient, spectator headroom.
REM set MAXCLIENTS=14
