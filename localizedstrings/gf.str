VERSION             "1"
CONFIG              ""
FILENOTES           ""

REFERENCE           TITLE
LANG_ENGLISH        "Gunfight"

REFERENCE           TITLE_CAPS
LANG_ENGLISH        "GUNFIGHT"

REFERENCE           TITLE_SHORT_CAPS
LANG_ENGLISH        "GF"

REFERENCE           SHORT
LANG_ENGLISH        "Gunfight"

REFERENCE           WIN_MATCH
LANG_ENGLISH        "Your team won the match!"

REFERENCE           WIN_ROUND
LANG_ENGLISH        "Enemy team eliminated!"

REFERENCE           MISSION_ACCOMPLISHED
LANG_ENGLISH        "Enemy team mission accomplished"

REFERENCE           ELIMINATED
LANG_ENGLISH        "Enemy team eliminated"

REFERENCE           FORFEITED
LANG_ENGLISH        "Enemy team forfeited"

REFERENCE           NAME
LANG_ENGLISH        "GUNFIGHT"

REFERENCE           GAMETYPE_DESC
LANG_ENGLISH        "Eliminate enemies to win the round.\n6 rounds to win. Random loadouts.\nNo respawns. No health regen."

REFERENCE           GAMETYPE_DESC_SCORE
LANG_ENGLISH        "Eliminate enemies to win the round.\n&&1 rounds to win. Random loadouts.\nNo respawns. No health regen."

REFERENCE           GAMETYPE_HINT
LANG_ENGLISH        "GUNFIGHT"

REFERENCE           GUN_DESC
LANG_ENGLISH        "Gun Game. Get a kill with each weapon to advance. First player to finish the full weapon sequence wins."

REFERENCE           SHRP_DESC
LANG_ENGLISH        "Sharpshooter. Everyone shares the same randomly rotating weapon. Most kills when time runs out wins."

REFERENCE           HLND_DESC
LANG_ENGLISH        "Sticks and Stones. Crossbow and ballistic knife only. Melee kills bankrupt an enemy's score. First to the score limit wins."

REFERENCE           OIC_DESC
LANG_ENGLISH        "One in the Chamber. One bullet, one life. Kill to earn another bullet. Last player standing wins the round."

// The score popups. English-only by construction: mod.ff is linked with
// -language english (build_ff.ps1) and one file is served to every client, so a
// custom string cannot follow the player's loc_language. Only STOCK references
// (@MPUI_*) localize per client, and the closest ones are plural ("Kills") and
// won't compose into "+1 Kill" - so this stays a literal.
// The reference name is deliberately unchanged (gf.gsc precache, _gf_hud.gsc,
// hud_gf_health.menu all cite GF_POPUP_ELIMINATION); only the text moved to "Kill".
REFERENCE           POPUP_ELIMINATION
LANG_ENGLISH        "+1 Kill"

REFERENCE           POPUP_ASSIST
LANG_ENGLISH        "+1 Assist"

// The overtime flag capture. Same literal-English reasoning as the two above.
REFERENCE           POPUP_CAPTURE
LANG_ENGLISH        "+1 Capture"

// ---------------------------------------------------------------------------
// LOAD-SCREEN TIPS (GF_TIP_0 .. GF_TIP_<N-1>), rendered by our ui_mp/connect.menu
// fork. Stock's own tips are UNREACHABLE: the engine picks one with the hardcoded
// command `selectStringTableEntryInDvar mp/didyouknow.csv 0 didyouknow` into the
// CLIENT dvar `didyouknow`, and BOTH the table (mp/didyouknow.csv) and the text
// (MPTIP_*) live in code_post_gfx_mp.ff / en_code_post_gfx_mp.ff, which the client
// loads BEFORE mod.ff -- first registration wins, so a mod.ff copy is discarded.
// connect.menu itself lives in ui_mp.ff, which loads AFTER mod.ff, so forking the
// RENDERER is the only route. See CLAUDE.md "Load-screen tips".
//
// ⚠ The reference names are positional: connect.menu builds "@GF_TIP_" + index at
// runtime, so they MUST stay a gapless 0-based run and GF_TIP_COUNT in
// ui_mp/connect.menu MUST equal the number of entries here. A gap renders blank.
// ⚠ English-only by construction, same as the score popups above.
// ⚠ Player-facing copy: no em dashes (CLAUDE.md house rule).

REFERENCE           TIP_0
LANG_ENGLISH        "A shared loadout that rotates every other round. All camos plus exclusive imported camos, selected randomly."

REFERENCE           TIP_1
LANG_ENGLISH        "One life per round. Last team standing wins the round, and the first team to win 6 rounds wins the match."

REFERENCE           TIP_2
LANG_ENGLISH        "No health regeneration, no custom loadouts, no killstreaks. Learn more at ^<gunfight.us"

REFERENCE           TIP_3
LANG_ENGLISH        "If time expires, capture the overtime flag to secure the round. Otherwise, the team with the most remaining health wins."

REFERENCE           TIP_4
LANG_ENGLISH        "All 26 maps (base + DLC), with wager-style sizes for small lobbies and full-map sizes for big ones."

REFERENCE           TIP_5
LANG_ENGLISH        "This Ranked Server provides real stats & XP. ^<4XP Enabled!^7 Learn more at ^<gunfight.us"

REFERENCE           TIP_6
LANG_ENGLISH        "Join the Black Ops Gunfight Discord for scrims, updates, and to find people to play with: ^5discord.gg/blackops"

ENDMARKER
