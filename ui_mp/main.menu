		// ----------------- BEGIN Scroller --------------------------
		// GF: stock's #include "ui/scroller.inc" is DELIBERATELY DROPPED. It is an
		// engine ownerdraw (UI_SCROLLING_MESSAGE 302 / _CATEGORY 303) whose content
		// we cannot set. We reuse its geometry and its stock bar art and put our
		// own copy in it.
		// ⚠ CORRECTED 2026-08-16: an earlier version of this comment said the
		// channel "carries nothing on Plutonium". FALSE -- Plutonium feeds it their
		// own promos (seen live: category "COD", text "Follow us on Twitter
		// @PlutoniumMod"). So dropping the include REPLACES A PLUTONIUM AD WITH
		// OURS, it does not fill dead space. The text is NOT in t5mp.exe (searched:
		// "PlutoniumMod" / "Follow us on Twitter" both absent), so it is fetched at
		// runtime by the injected client module -- same delivery as the launcher's
		// ad rotation ([[plutonium-menu-ads-not-moddable]]) and equally unsettable
		// from our side. Replacing the ITEMDEF is the only lever, which is why this
		// works here and why changing the SAME ticker on any other screen means
		// forking THAT screen's .menu too (class.menu, endofgame.menu, the lobby
		// menus -- 13 stock files include ui/scroller.inc).
		// ----------------- END Scroller ----------------------------

		// ================= BEGIN gunfight.us ad rotation ====================
		// EVERYTHING here is CLIENT-LOCAL. milliseconds() in a menu exp is the
		// client's UI realtime clock and runs with no server connection (stock's
		// fog scroller and corner glows above use it the same way), so the
		// rotation costs zero dvars, zero reliable commands and no GSC at all.
		// min/max/int/float are real exp functions (raw/expressions/functions.txt).
		//
		// AD_T( n ) is "ms since slot n opened", wrapped to the cycle: slot n is
		// the live one exactly while AD_T( n ) < AD_SLOT_MS. AD_ALPHA is a
		// trapezoid over that window (ramp in, hold, ramp out) so lines cross-fade
		// instead of popping.
		// The billboard and the ticker run DIFFERENT periods on purpose, so they
		// drift against each other rather than flipping in lockstep.

#define AD_COUNT			8
#define AD_SLOT_MS			6000
#define AD_FADE_MS			600
#define AD_CYCLE_MS			( AD_SLOT_MS * AD_COUNT )
#define AD_T( n )			( ( milliseconds() + AD_CYCLE_MS - ( n * AD_SLOT_MS ) ) % AD_CYCLE_MS )
#define AD_VIS( n )			when( AD_T( n ) < AD_SLOT_MS );
#define AD_ALPHA( n )		( max( 0, min( 1, min( float( AD_T( n ) ) / AD_FADE_MS, float( AD_SLOT_MS - AD_T( n ) ) / AD_FADE_MS ) ) ) )

// (The TK_* ticker macros used to be declared here as well as beside the bar itself; they now
// live once in ui_mp/gf_ticker.inc, included at the ticker block below.)

		// ---- surface 1: bottom-left billboard ----
		// Anchored at x -258 relative to CENTER -- the exact left edge of the
		// button column (CHOICE_X_START) -- so the block stays aligned with the
		// buttons at any aspect ratio, and VERTICAL_ALIGN_BOTTOM so it hugs the
		// lower-left corner. Width is capped at 180 (the button width) so every
		// line ends left of the ticker bar, which starts at x -77 rel centre.
		//
		// Branding follows gf_lobby_hud's idiom (hud_gf_health.menu): orange
		// 1 0.42 0.1 eyebrow over a white GUNFIGHT wordmark, grey body copy,
		// orange link lines. Copy is lifted from site/wwwroot/index.html and the
		// lobby HUD -- OWNER-AUTHORED text, never invented here (house rule:
		// marketing copy is the owner's).
#define AD_X				-258
#define AD_W				180
#define GF_LINK_COLOR		1 0.42 0.1 1
#define GF_BODY_COLOR		0.72 0.75 0.78 1
#define AD_LINE( n, y, txt, size, col )																		\
		PREPROC_TEXT_DRAW_VIS_EX( AD_X y AD_W 20 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_BOTTOM,				\
								  0 0, txt, size, 0, 0, ITEM_ALIGN_LEFT, col,								\
								  AD_VIS( n ), exp forecolor a ( AD_ALPHA( n ) ); )

		// persistent branding (no rotation, always on): one line, the block's
		// header. The ticker bar carries both full links, so repeating them
		// here would just be duplication.
		PREPROC_TEXT_DRAW( AD_X -136 AD_W 14 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_BOTTOM,
						   0 0, "gunfight.us", 0.32, 0, 0, ITEM_ALIGN_LEFT, GF_LINK_COLOR )

		// rotating stanzas: headline + subline share a slot, so they fade
		// together. RULES and FEATURES interleaved -- rules from the site's
		// About sentences + the lobby rules line, features from the index.html
		// feature-card <h3>s (sublines trimmed from the cards' own sentences).
		AD_LINE( 0, -112, "50+ unique loadouts",						0.35, COLOR_TITLE )
		AD_LINE( 0,  -94, "Both teams get the same kit each round",	0.24, GF_BODY_COLOR )

		AD_LINE( 1, -112, "Exclusive weapon camos",					0.35, COLOR_TITLE )
		AD_LINE( 1,  -94, "All camos plus exclusive imported camos",	0.24, GF_BODY_COLOR )

		AD_LINE( 2, -112, "All 26 maps & size scaling",				0.35, COLOR_TITLE )
		AD_LINE( 2,  -94, "Wager-map sizes for smaller lobbies",	0.24, GF_BODY_COLOR )

		AD_LINE( 3, -112, "First to 6 rounds wins",					0.35, COLOR_TITLE )
		AD_LINE( 3,  -94, "Most remaining health wins the round",	0.24, GF_BODY_COLOR )

		AD_LINE( 4, -112, "Overtime objective",						0.35, COLOR_TITLE )
		AD_LINE( 4,  -94, "Hold-to-capture flag spawns center-map",	0.24, GF_BODY_COLOR )

		AD_LINE( 5, -112, "One life per round",						0.35, COLOR_TITLE )
		AD_LINE( 5,  -94, "No respawns, no health regen",			0.24, GF_BODY_COLOR )

		AD_LINE( 6, -112, "Real stats & XP",							0.35, COLOR_TITLE )
		AD_LINE( 6,  -94, "Ranked server. 4XP Enabled!",			0.24, GF_BODY_COLOR )

		AD_LINE( 7, -112, "Configurable bots",						0.35, COLOR_TITLE )
